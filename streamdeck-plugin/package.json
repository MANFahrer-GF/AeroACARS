{
  "name": "aeroacars-streamdeck",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "erzeugen": "node skripte/erzeugen.mjs",
    "build": "npm run erzeugen && rollup -c",
    "test": "node --test test/*.test.js",
    "pack": "npm run build && streamdeck validate eu.german-sky-group.aeroacars.sdPlugin && streamdeck pack eu.german-sky-group.aeroacars.sdPlugin --output dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.2"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.2",
    "@rollup/plugin-commonjs": "28.0.1",
    "@rollup/plugin-node-resolve": "15.3.0",
    "rollup": "4.24.0"
  }
}
